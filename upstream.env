PACKAGE_REVISION=current

# Forward development follows branch heads at build time.
STREMIO_SOURCE_REPOSITORY=https://github.com/Stremio/stremio-linux-shell.git
STREMIO_SOURCE_BRANCH=main

RK_FFMPEG_REPOSITORY=https://github.com/ryanfitz/FFmpeg.git
RK_FFMPEG_BRANCH=rk3588-hevc-rps-controls

RK_MPV_REPOSITORY=https://github.com/ryanfitz/mpv-rockchip.git
RK_MPV_BRANCH=rk3588-nv15-gpu-next

RK_LIBPLACEBO_REPOSITORY=https://github.com/haasn/libplacebo.git
RK_LIBPLACEBO_BRANCH=master

RK_STACK_PREFIX=/opt/stremio/rk3588
