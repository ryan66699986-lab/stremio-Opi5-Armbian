From: stremio-Opi5-Armbian maintainers
Subject: [PATCH] Linux: build against system libmpv and modern mpv API

Keep the official 4.4.181 shell source as the base while applying the small
Linux compatibility changes needed by current Ubuntu/libmpv:

* select Qt 5 on non-Windows builds as well;
* use the distro libmpv client headers/library on Linux, retaining only the
  bundled qthelper.hpp compatibility helper;
* adapt the OpenGL init struct and removed cache properties for modern mpv;
* translate legacy properties emitted by the Stremio web UI;
* initialize Qt WebEngine before constructing the QML engine.

This patch does not add, link, or load Rubber Band directly.
---
 CMakeLists.txt | 17 ++++++++++++++---
 main.cpp       |  3 +++
 mpv.cpp        | 22 ++++++++++++++++++----
 3 files changed, 35 insertions(+), 7 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 5e68415..0000000 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -35,15 +35,19 @@ set(SOURCES
   qml.qrc
 )
 
-set(MPV_INCLUDE_DIR ${CMAKE_CURRENT_SOURCE_DIR}/deps/libmpv/include)
+if(NOT DEFINED QT_DEFAULT_MAJOR_VERSION)
+  set(QT_DEFAULT_MAJOR_VERSION 5)
+endif()
+
 if(WIN32)
+  set(MPV_INCLUDE_DIR ${CMAKE_CURRENT_SOURCE_DIR}/deps/libmpv/include)
   list(APPEND SOURCES stremio.rc)
-  set(QT_DEFAULT_MAJOR_VERSION 5)
   set(ENV{Qt6_DIR} $ENV{QTDIR})
   set(MPV_LIBRARY_mpv ${CMAKE_CURRENT_SOURCE_DIR}/deps/libmpv/win32/mpv.lib)
 endif()
 
 if(APPLE)
+  set(MPV_INCLUDE_DIR ${CMAKE_CURRENT_SOURCE_DIR}/deps/libmpv/include)
   list(APPEND SOURCES images/stremio.icns)
   set_source_files_properties(images/stremio.icns PROPERTIES MACOSX_PACKAGE_LOCATION "Resources")
   set(MPV_LIBRARY_mpv ${CMAKE_CURRENT_SOURCE_DIR}/iina/deps/lib/libmpv.dylib)
@@ -95,6 +99,15 @@ target_include_directories(${PROJECT_NAME} PRIVATE
   ${MPV_INCLUDE_DIR}
 )
 
+# qthelper.hpp is not installed by libmpv-dev.  Use only that compatibility
+# helper from the pinned libmpv submodule so its old client.h cannot shadow
+# Ubuntu's system libmpv headers.
+if(UNIX AND NOT APPLE)
+  file(MAKE_DIRECTORY ${CMAKE_BINARY_DIR}/mpv-compat/mpv)
+  file(COPY ${CMAKE_CURRENT_SOURCE_DIR}/deps/libmpv/include/mpv/qthelper.hpp DESTINATION ${CMAKE_BINARY_DIR}/mpv-compat/mpv)
+  target_include_directories(${PROJECT_NAME} PRIVATE ${CMAKE_BINARY_DIR}/mpv-compat)
+endif()
+
 target_link_libraries(${PROJECT_NAME} LINK_PUBLIC
   Qt5::Qml
   Qt5::Quick
diff --git a/main.cpp b/main.cpp
index d571c4e..0000000 100644
--- a/main.cpp
+++ b/main.cpp
@@ -94,4 +94,7 @@ int main(int argc, char **argv)
     std::setlocale(LC_NUMERIC, "C");
     
 
+    // Qt WebEngine must be initialized before the QML engine on this target.
+    QtWebEngine::initialize();
+
     static QQmlApplicationEngine* engine = new QQmlApplicationEngine();
diff --git a/mpv.cpp b/mpv.cpp
index 06fc4c4..0000000 100644
--- a/mpv.cpp
+++ b/mpv.cpp
@@ -54,7 +54,7 @@ class MpvRenderer : public QQuickFramebufferObject::Renderer
         // init mpv_gl:
         if (!obj->mpv_gl)
         {
-            mpv_opengl_init_params gl_init_params{get_proc_address_mpv, nullptr, nullptr};
+            mpv_opengl_init_params gl_init_params{get_proc_address_mpv, nullptr};
             mpv_render_param params[]{
                 {MPV_RENDER_PARAM_API_TYPE, const_cast<char *>(MPV_RENDER_API_TYPE_OPENGL)},
                 {MPV_RENDER_PARAM_OPENGL_INIT_PARAMS, &gl_init_params},
@@ -138,8 +138,8 @@ void MpvObject::initialize_mpv() {
     //mpv::qt::set_property(mpv, "opengl-backend", "angle");
 
-    // Set cache to a reasonable value
-    mpv::qt::set_property(mpv, "cache-default", 15000);
-    mpv::qt::set_property(mpv, "cache-backbuffer", 15000);
+    // Modern mpv removed cache-default/cache-backbuffer.
+    mpv::qt::set_property(mpv, "demuxer-max-bytes", "150MiB");
+    mpv::qt::set_property(mpv, "demuxer-max-back-bytes", "75MiB");
     mpv::qt::set_property(mpv, "cache-secs", 10);
 
     // Visible app / stream names
@@ -177,6 +177,18 @@ void MpvObject::command(const QVariant& params)
 
 void MpvObject::setProperty(const QString& name, const QVariant& value)
 {
+    if (name == "vo" && value.toString() == "opengl-cb") {
+        mpv::qt::set_property(mpv, "vo", "libmpv");
+        return;
+    }
+    if (name == "input-defalt-bindings") {
+        mpv::qt::set_property(mpv, "input-default-bindings", value);
+        return;
+    }
+    if (name == "cache-default" || name == "cache-backbuffer") {
+        return;
+    }
+
     mpv::qt::set_property(mpv, name, value);
 }
 
