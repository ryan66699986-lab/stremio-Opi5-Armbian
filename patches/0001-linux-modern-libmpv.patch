From: stremio-Opi5-Armbian maintainers
Subject: [PATCH] Linux: modern libmpv API and RK3588 V4L2-request decode

Keep the official 4.4.181 shell source as the base while applying the Linux
compatibility changes needed by current Qt/libmpv and the private RK3588
V4L2-request multimedia stack:

* select Qt 5 on non-Windows builds as well;
* allow the build to use the configured libmpv client headers/library while
  retaining only the bundled qthelper.hpp compatibility helper;
* adapt the OpenGL init struct and removed cache properties for modern mpv;
* translate legacy properties emitted by the Stremio web UI;
* map Stremio's generic hwdec=yes/auto request to v4l2request-copy first, then
  direct v4l2request and the normal safe fallback;
* set AA_ShareOpenGLContexts and initialize Qt WebEngine before constructing
  QApplication/MainApp.

The copy-first ordering keeps RK3588 hardware decoding while avoiding direct
DRM-PRIME import of packed 10-bit surfaces in Stremio's legacy libmpv OpenGL
render API. The pinned Rockchip mpv fork's NV15 unpack path is implemented in
vo_gpu_next, which an embedded libmpv render client does not execute.

This patch does not add, link, or load Rubber Band directly.
---
 CMakeLists.txt | 17 +++++++++++++++--
 main.cpp       |  4 ++++
 mpv.cpp        | 31 +++++++++++++++++++++++++++----
 3 files changed, 46 insertions(+), 6 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 5e68415..0000000 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -35,15 +35,19 @@ set(SOURCES
   qml.qrc
 )
 
-set(MPV_INCLUDE_DIR ${CMAKE_CURRENT_SOURCE_DIR}/deps/libmpv/include)
+if(NOT DEFINED QT_DEFAULT_MAJOR_VERSION)
+  set(QT_DEFAULT_MAJOR_VERSION 5)
+endif()
+
 if(WIN32)
+  set(MPV_INCLUDE_DIR ${CMAKE_CURRENT_SOURCE_DIR}/deps/libmpv/include)
   list(APPEND SOURCES stremio.rc)
-  set(QT_DEFAULT_MAJOR_VERSION 5)
   set(ENV{Qt6_DIR} $ENV{QTDIR})
   set(MPV_LIBRARY_mpv ${CMAKE_CURRENT_SOURCE_DIR}/deps/libmpv/win32/mpv.lib)
 endif()
 
 if(APPLE)
+  set(MPV_INCLUDE_DIR ${CMAKE_CURRENT_SOURCE_DIR}/deps/libmpv/include)
   list(APPEND SOURCES images/stremio.icns)
   set_source_files_properties(images/stremio.icns PROPERTIES MACOSX_BUNDLE_ICON_FILE "stremio.icns")
   set(MPV_LIBRARY_mpv ${CMAKE_CURRENT_SOURCE_DIR}/iina/deps/lib/libmpv.dylib)
@@ -95,6 +99,15 @@ target_include_directories(${PROJECT_NAME} PRIVATE
   ${MPV_INCLUDE_DIR}
 )
 
+# qthelper.hpp is not installed by libmpv. Use only that compatibility helper
+# from the pinned libmpv submodule so its old client.h cannot shadow the
+# configured modern libmpv headers.
+if(UNIX AND NOT APPLE)
+  file(MAKE_DIRECTORY ${CMAKE_BINARY_DIR}/mpv-compat/mpv)
+  file(COPY ${CMAKE_CURRENT_SOURCE_DIR}/deps/libmpv/include/mpv/qthelper.hpp DESTINATION ${CMAKE_BINARY_DIR}/mpv-compat/mpv)
+  target_include_directories(${PROJECT_NAME} PRIVATE ${CMAKE_BINARY_DIR}/mpv-compat)
+endif()
+
 target_link_libraries(${PROJECT_NAME} LINK_PUBLIC
   Qt5::Qml
   Qt5::Quick
diff --git a/main.cpp b/main.cpp
index d571c4e..0000000 100644
--- a/main.cpp
+++ b/main.cpp
@@ -70,6 +70,10 @@ int main(int argc, char **argv)
     Application::setAttribute(Qt::AA_EnableHighDpiScaling);
     #endif
 
+    // These must be set/initialized before QApplication/MainApp is created.
+    Application::setAttribute(Qt::AA_ShareOpenGLContexts);
+    QtWebEngine::initialize();
+
     Application::setApplicationName("Stremio");
     Application::setApplicationVersion(STREMIO_SHELL_VERSION);
     Application::setOrganizationName("Smart Code ltd");
diff --git a/mpv.cpp b/mpv.cpp
index 06fc4c4..0000000 100644
--- a/mpv.cpp
+++ b/mpv.cpp
@@ -54,7 +54,7 @@ class MpvRenderer : public QQuickFramebufferObject::Renderer
         // init mpv_gl:
         if (!obj->mpv_gl)
         {
-            mpv_opengl_init_params gl_init_params{get_proc_address_mpv, nullptr, nullptr};
+            mpv_opengl_init_params gl_init_params{get_proc_address_mpv, nullptr};
             mpv_render_param params[]{
                 {MPV_RENDER_PARAM_API_TYPE, const_cast<char *>(MPV_RENDER_API_TYPE_OPENGL)},
                 {MPV_RENDER_PARAM_OPENGL_INIT_PARAMS, &gl_init_params},
@@ -138,8 +138,8 @@ void MpvObject::initialize_mpv() {
     //mpv::qt::set_property(mpv, "opengl-backend", "angle");
 
-    // Set cache to a reasonable value
-    mpv::qt::set_property(mpv, "cache-default", 15000);
-    mpv::qt::set_property(mpv, "cache-backbuffer", 15000);
+    // Modern mpv removed cache-default/cache-backbuffer.
+    mpv::qt::set_property(mpv, "demuxer-max-bytes", "150MiB");
+    mpv::qt::set_property(mpv, "demuxer-max-back-bytes", "75MiB");
     mpv::qt::set_property(mpv, "cache-secs", 10);
 
     // Visible app / stream names
@@ -177,6 +177,29 @@ void MpvObject::command(const QVariant& params)
 
 void MpvObject::setProperty(const QString& name, const QVariant& value)
 {
+    if (name == "vo" && value.toString() == "opengl-cb") {
+        mpv::qt::set_property(mpv, "vo", "libmpv");
+        return;
+    }
+    if (name == "input-defalt-bindings") {
+        mpv::qt::set_property(mpv, "input-default-bindings", value);
+        return;
+    }
+    if (name == "cache-default" || name == "cache-backbuffer") {
+        return;
+    }
+    if (name == "hwdec" &&
+        (value.toString() == "yes" || value.toString() == "auto")) {
+        // Keep decoding on the RK3588 VPU, but prefer the copy variant. The
+        // Stremio shell uses libmpv's OpenGL render API rather than mpv's
+        // vo_gpu_next path, so directly imported packed 10-bit NV15 DRM PRIME
+        // surfaces can be interpreted incorrectly by the legacy renderer.
+        // v4l2request-copy downloads the decoded frame to a conventional
+        // software pixel format before rendering; direct request decode and
+        // mpv's normal safe methods remain fallbacks.
+        mpv::qt::set_property(mpv, "hwdec", "v4l2request-copy,v4l2request,auto-safe");
+        return;
+    }
+
     mpv::qt::set_property(mpv, name, value);
 }
 
