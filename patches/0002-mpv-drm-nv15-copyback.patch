     // Try to find the first format which we can apparently use.
     int imgfmt = 0;
     enum AVPixelFormat *fmts;
@@ -286,6 +434,9 @@ struct mp_image *mp_image_hw_download(struct mp_image *src,
                                       struct mp_image_pool *swpool)
 {
+    if (mp_image_is_drm_nv15(src))
+        return mp_image_hw_download_nv15(src, swpool);
+
     int imgfmt = mp_image_hw_download_get_sw_format(src);
     if (!imgfmt)
         return NULL;
